{
  "ax-free": {
    "name": "ax-free",
    "description": "Shared free route for general roles, operations, Holmes and Harness2: North Mini Code first, NVIDIA Lightning fallback.",
    "strategy": "priority",
    "models": [
      {
        "kind": "model",
        "providerId": "openrouter",
        "model": "openrouter/cohere/north-mini-code:free"
      },
      {
        "kind": "model",
        "providerId": "nvidia",
        "model": "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b"
      }
    ],
    "config": {
      "targetTimeoutMs": 45000,
      "comboTimeoutMs": 105000,
      "maxGlobalAttempts": 2,
      "maxSetRetries": 0,
      "compressionMode": "off"
    }
  },
  "ax-ollama": {
    "name": "ax-ollama",
    "description": "Ollama Cloud: pinned DeepSeek V4 Pro 0813 first, pinned DeepSeek V4.1 Flash 1017 fallback, then GLM 5.3 Flash. No duplicate aliases or retiring MiniMax.",
    "strategy": "priority",
    "models": [
      {
        "kind": "model",
        "providerId": "ollama-cloud",
        "model": "ollama-cloud/deepseek-v4.1-flash:1017"
      },
      {
        "kind": "model",
        "providerId": "ollama-cloud",
        "model": "ollama-cloud/glm-5.3-flash"
      },
      {
        "kind": "model",
        "providerId": "ollama-cloud",
        "model": "ollama-cloud/deepseek-v4-pro:0813"
      }
    ],
    "config": {
      "targetTimeoutMs": 600000,
      "comboTimeoutMs": 870000,
      "maxGlobalAttempts": 3,
      "maxSetRetries": 0,
      "compressionMode": "off"
    }
  }
}
