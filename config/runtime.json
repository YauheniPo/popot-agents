{
  "sessions": {
    "default_idle_seconds": 900,
    "retention_days": 7,
    "prune_interval_seconds": 60
  },
  "timeouts": {
    "model_request_seconds": 120,
    "mcp_discovery_seconds": 60,
    "mcp_tool_seconds": 120,
    "mcp_upstream_seconds": 7200,
    "tool_command_seconds": 180,
    "git_clone_seconds": 180,
    "file_action_seconds": 60,
    "file_download_seconds": 60,
    "postgres_connect_seconds": 10,
    "memory_request_seconds": 5,
    "memory_recall_seconds": 20,
    "memory_session_start_seconds": 3,
    "memory_session_finish_seconds": 5,
    "memory_summary_seconds": 30,
    "memory_capture_min_seconds": 8,
    "memory_capture_margin_seconds": 5,
    "memory_recall_min_seconds": 1,
    "memory_tool_request_seconds": 60,
    "memory_skill_import_seconds": 600,
    "turn_seconds": 900,
    "max_turn_seconds": 1800,
    "min_turn_seconds": 0.1,
    "turn_response_margin_seconds": 15
  },
  "limits": {
    "request_bytes": 262144,
    "message_chars": 30000,
    "history_bytes": 500000,
    "socket_message_bytes": 1048576,
    "tool_output_chars": 24000,
    "write_file_bytes": 500000,
    "download_bytes": 20000000,
    "skill_prompt_bytes": 262144
  },
  "logging": {
    "mcp_body_max_bytes": 65536,
    "worker_log_tail_lines": 200,
    "worker_log_max_bytes": 1048576
  },
  "model": {
    "default_max_tool_rounds": 40,
    "request_retries": 10,
    "temperature": null,
    "max_tokens": null,
    "final_answer_reserve_seconds": 120,
    "final_answer_reserve_divisor": 3,
    "max_tool_rounds": 80
  },
  "role_env_names": [
    "GITHUB_PERSONAL_ACCESS_TOKEN",
    "COGNEE_API_URL",
    "COGNEE_PASSWORD"
  ],
  "memory": {
    "summary_attempts": 2,
    "summary_max_tokens": 2000,
    "summary_retry_max_tokens": 4000,
    "recall_top_k": 8,
    "task_chars": 8000,
    "query_chars": 4000,
    "chunk_chars": 4000,
    "context_chars": 24000,
    "tool_evidence_chars": 6000,
    "tool_evidence_count": 12,
    "answer_chars": 8000,
    "max_memories": 5,
    "text_chars": 1600,
    "quote_chars": 600,
    "trace_tool_limit": 200
  },
  "docker": {
    "max_concurrent_tasks": 3,
    "memory": "1536m",
    "cpus": 2,
    "pids_limit": 256,
    "tmpfs_mb": 64,
    "workspace_tmpfs_mb": 512,
    "startup_probe_attempts": 40,
    "startup_probe_interval_seconds": 0.25,
    "start_timeout_seconds": 30,
    "probe_timeout_seconds": 5,
    "restore_timeout_seconds": 30,
    "inspect_timeout_seconds": 10,
    "remove_timeout_seconds": 10
  },
  "ax": {
    "context": "kind-popot-ax",
    "atespace": "ate-demo-counter",
    "worker_pool_name": "popot-workers",
    "workspace_name": "popot-local",
    "task_resources": {
      "requests": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "2",
        "memory": "1536Mi"
      }
    },
    "task_debug": true,
    "cli_timeout_seconds": 60,
    "route_timeout_seconds": 1920,
    "startup_timeout_seconds": 300,
    "startup_probe_interval_seconds": 3,
    "session_backend": "postgres",
    "probe_timeout_seconds": 15,
    "restore_timeout_seconds": 30,
    "response_margin_seconds": 10,
    "delete_timeout_seconds": 5,
    "suspend_retention_seconds": 7200,
    "max_workers": 10,
    "worker_queue_timeout_seconds": 3600,
    "delegation": {
      "enabled": true,
      "port": 8005,
      "max_depth": 5,
      "max_calls_per_turn": 8,
      "turn_timeout_seconds": 900,
      "poll_interval_seconds": 0.5
    },
    "proxy": {
      "port": 8004,
      "response_margin_seconds": 5,
      "max_request_bytes": 2097152,
      "max_response_bytes": 4194304
    }
  }
}
