{
  "api_base": "http://host.docker.internal:20128/v1",
  "max_steps": 12,
  "max_output_tokens": 4096,
  "llm_args": {
    "max_tokens": 8192,
    "extra_body": {
      "reasoning": {
        "enabled": false
      },
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "custom_args": {
      "max_context_size": 65536
    }
  },
  "active_deadline_seconds": 600,
  "ttl_seconds_after_finished": 86400,
  "resources": {
    "requests": {
      "cpu": "100m",
      "memory": "512Mi"
    },
    "limits": {
      "cpu": "1",
      "memory": "2Gi"
    }
  }
}
