# Copy this file to .env and fill in only the providers you use.
# Keep .env private. It is excluded from Git and the Docker build context.
POPOT_DB_PASSWORD=
AX_MCP_PUBLISH_PORT=8003
# Generated privately by bash memory/up.sh; use the same password to log into the UI.
COGNEE_PASSWORD=
# Optional override for sessions.default_idle_seconds in config/runtime.json:
# AGENT_CHAT_IDLE_SECONDS=900
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
# OmniRoute bootstrap uses config/omniroute/settings.json and config/omniroute/combos.json.
# Keep an existing gateway key; for a fresh instance generate a private random secret.
# The bootstrap registers this value with restricted model/connection/combo access.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=ax-free
OMNIROUTE_CODE_MODEL=ax-code-free
# Optional paid Ollama Cloud combo for either variable above: ax-ollama.
OMNIROUTE_OPS_MODEL=ax-ops-free
# Required when Harness2 is enabled for a role in config/roles/*.json.
HARNESS2_IMPROVER_MODEL=ax-harness-free
# Set a strong first-boot dashboard password; bootstrap uses it for management login.
# On an existing instance this must match its current dashboard password.
OMNIROUTE_INITIAL_PASSWORD=
# Required for on-demand Holmes diagnosis; use a configured free-only combo.
HOLMES_MODEL=ax-ops-free
OLLAMA_LOCAL_MODEL=qwen2.5-coder:14b
# Also required by OmniRoute bootstrap for ax-ollama.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash:1017
NOUS_API_KEY=
NOUS_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
