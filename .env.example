# Copy this file to .env and fill in only the providers you use.
# Keep .env private. It is excluded from Git and the Docker build context.
POPOT_DB_PASSWORD=
API_PUBLISH_PORT=8000
MCP_PUBLISH_PORT=8001
# Generated privately by bash memory/up.sh; use the same password to log into the UI.
COGNEE_PASSWORD=
# Optional override for standard Docker workers (AX resolves the kind-network API):
# COGNEE_API_URL=http://host.docker.internal:3001
# Optional override for sessions.default_idle_seconds in config/runtime.json:
# AGENT_CHAT_IDLE_SECONDS=900
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
OLLAMA_CLAUDE_MODEL=
NOUS_API_KEY=
NOUS_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
